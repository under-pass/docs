{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "UnderPass Developer Docs",
  "description": "Public API for events, reservations, seats, waiting rooms and ticket checkout on the UnderPass platform",
  "colors": {
    "primary": "#00A98B",
    "light": "#00D1B2",
    "dark": "#008A72"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "changelog"
            ]
          },
          {
            "group": "Selling",
            "pages": [
              "guides/reservations",
              "guides/performances",
              "guides/seating",
              "guides/waiting-room",
              "guides/fees-and-installments"
            ]
          },
          {
            "group": "Tickets",
            "pages": [
              "guides/group-tickets-and-attendees",
              "guides/bar-perks",
              "guides/ticket-attributes"
            ]
          },
          {
            "group": "Measurement",
            "pages": [
              "analytics-pixels",
              "guides/attribution"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": {
          "source": "/api-reference/openapi.json",
          "directory": "api-reference"
        },
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:developers@underpass.com.co"
      },
      {
        "label": "Status",
        "href": "https://underpass.com.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "UnderPass",
      "href": "https://underpass.com.co"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/under-pass"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#101010"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Lexend"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "seo": {
    "metatags": {
      "og:site_name": "UnderPass Developer Docs",
      "og:type": "website",
      "og:image": "https://docs.underpass.com.co/images/og.png",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.underpass.com.co/images/og.png",
      "keywords": "ticketing API, event ticketing, white-label checkout, Colombia, UnderPass, boletería, venta de boletas, seat map API, waiting room, ticket reservations",
      "author": "UnderPass",
      "robots": "index, follow",
      "theme-color": "#101010"
    },
    "indexing": "navigable"
  }
}
