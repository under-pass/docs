{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "UnderPass Developer Docs",
  "description": "Public API for events and ticket checkout on the UnderPass platform",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0369A1"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Integration guides",
            "pages": [
              "analytics-pixels"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": {
          "source": "/api-reference/openapi.json",
          "directory": "api-reference"
        },
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:developers@underpass.com.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "UnderPass",
      "href": "https://underpass.com.co"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/under-pass"
    }
  }
}
