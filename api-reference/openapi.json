      "EventArtistDto": {
        "type": "object",
        "description": "Lineup entry. Sort by `position` ascending when rendering the lineup.",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "artist_id": {
            "type": "string"
          },
          "performance_type": {
            "type": "string",
            "enum": [
              "headliner",
              "dj_set",
              "live_set",
              "support"
            ],
            "description": "Artist role. Treat unknown values as \"support\"."
          },
          "performance_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "stage_notes": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "artist": {
            "$ref": "#/components/schemas/ArtistDto"
          }
        }
      },
      "LocalityDto": {
        "type": "object",
        "description": "A logical seating zone within an event (e.g. GENERAL, BACKSTAGE). Tickets are scoped to a locality.",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "GENERAL"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_document_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CC",
                "CE",
                "PA",
                "TI",
                "NIT",
                "PEP",
                "DNI",
                "RUT"
              ]
            },
            "description": "Empty array means all document types are allowed."
          },
          "position": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TicketTypeDto": {
        "type": "object",
        "description": "A purchasable ticket variant within a locality. Pricing varies per `SellingStage`.",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "locality_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Early Bird"
          },
          "description": {
            "type": "string"
          },
          "group_size": {
            "type": "integer",
            "description": "Number of attendees per ticket (1 = single, 2 = 2-for-1, etc.)."
          },
          "max_per_order": {
            "type": "integer",
            "nullable": true
          },
          "requires_info": {
            "type": "boolean",
            "description": "When true, buyer must fill in attendee info per ticket at checkout."
          },
          "transferable": {
            "type": "boolean"
          },
          "allows_split_payment": {
            "type": "boolean"
          },
          "min_initial_payment": {
            "type": "number",
            "nullable": true
          },
          "max_payment_installments": {
            "type": "integer"
          },
          "promoter_commission": {
            "type": "string",
            "description": "Commission paid to promoters per sold ticket. **Decimal serialized as string** \u2014 parse before doing math (`parseFloat(promoter_commission)`).",
            "example": "5000"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "locality": {
            "$ref": "#/components/schemas/LocalityDto"
          }
        }
      },
      "StagePricingDto": {
        "type": "object",
        "description": "Price of a TicketType within a specific SellingStage.",
        "properties": {
          "id": {
            "type": "string"
          },
          "selling_stage_id": {
            "type": "string"
          },
          "ticket_type_id": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "description": "Price in `currency` integer units (no decimals for COP). **Decimal serialized as string** \u2014 parse with `parseInt(price, 10)` for display.",
            "example": "30000"
          },
          "currency": {
            "type": "string",
            "enum": [
              "COP"
            ],
            "description": "Currently always COP."
          },
          "is_courtesy": {
            "type": "boolean",
            "description": "Courtesy (gifted) ticket \u2014 no payment required."
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ],
            "description": "`PRIVATE` tickets only appear when unlocked via a sales link or promo code."
          },
          "max_quantity_in_stage": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "SellingStageDto": {
        "type": "object",
        "description": "A sales window for an event. Each ticket type has a `StagePricing` row per stage.",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Preventa 1"
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "end_date": {
            "type": "string",
            "format": "date-time"
          },
          "max_tickets": {
            "type": "integer",
            "description": "Hard cap across all ticket types in this stage. `null` = uncapped.",
            "nullable": true
          },
          "is_hidden": {
            "type": "boolean",
            "description": "Hidden stages are only revealed by promo codes that grant `UNLOCK_STAGE`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "stagePricing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StagePricingDto"
            },
            "description": "Pricing per ticket type in this stage. Included on `ticketAvailability[].sellingStage`."
          }
        }
      },
      "TicketAvailabilityDto": {
        "type": "object",
        "description": "The denormalized \"what to render in the ticket picker\" view. One entry per (TicketType \u00d7 currently-active SellingStage) \u2014 already filtered to what the buyer can actually purchase right now.",
        "properties": {
          "ticketType": {
            "$ref": "#/components/schemas/TicketTypeDto"
          },
          "sellingStage": {
            "$ref": "#/components/schemas/SellingStageDto"
          },
          "totalDelta": {
            "type": "integer",
            "description": "Total available units across the locality."
          },
          "available": {
            "type": "integer",
            "description": "Remaining units for THIS ticket type. Render \"Agotado\" badge when `<= 0`."
          },
          "maxQuantity": {
            "type": "integer",
            "nullable": true
          },
          "stagePricing": {
            "$ref": "#/components/schemas/StagePricingDto"
          }
        }
      },
      "OrganizerDto": {
        "type": "object",
        "description": "Public-facing organizer info shown on event pages. On the list endpoint only `collective` is populated; on the by-slug endpoint the legal / contact fields are also included so the page can render a full organizer card.",
        "properties": {
          "collective": {
            "type": "string",
            "description": "Organizer / collective display name.",
            "example": "Euphorika"
          },
          "legalRepresentative": {
            "type": "string",
            "nullable": true,
            "description": "Legal entity name. Slug endpoint only.",
            "example": "EUPHORIKA SAS"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Public contact email for the organizer. Slug endpoint only."
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Public contact phone for the organizer. Slug endpoint only."
          },
          "nit": {
            "type": "string",
            "nullable": true,
            "description": "Colombian tax ID (NIT). Slug endpoint only."
          }
        }
      },
      "PaginationDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 50
          },
          "total": {
            "type": "integer",
            "example": 7
          },
          "total_pages": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  }
