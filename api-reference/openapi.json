          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "genre": {
            "type": "string"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "instagram": {
            "type": "string",
            "description": "Handle including the `@`.",
